# Copy to /etc/quireloop/backup.env, edit, and keep it readable by root only.
QUIRELOOP_DATA_DIR=/var/lib/quireloop/data

# A folder on a different physical disk. The script refuses the same disk.
BACKUP_DIR=/mnt/backup/quireloop

# KEEP_RECENT_HOURS=24
# KEEP_DAILY=14
# KEEP_MONTHLY=6

# Optional: copy the papers off this machine with rclone. Set up the remote
# with `sudo rclone config`, and wrap it in a "crypt" remote so the cloud
# company can't read unpublished papers. See docs/admin-guide.md.
# RCLONE_REMOTE=onedrive-crypt:quireloop
